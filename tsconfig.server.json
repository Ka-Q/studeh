{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "outDir": "dist",
        "rootDir": "src",
        "rewriteRelativeImportExtensions": true
    },
    "include": ["src/server/**/*.ts", "src/shared/**/*.ts"],
    "exclude": ["src/server/**/*.test.ts"]
}
