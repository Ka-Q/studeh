{
  "name": "studeh",
  "version": "0.1.0",
  "private": true,
  "description": "Local image-occlusion study app.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json && vite build",
    "start": "npm run build && node dist/server/index.js",
    "dev": "concurrently -n client,server,run -c blue,green,yellow \"npm:dev:client\" \"npm:dev:server\" \"npm:dev:run\"",
    "predev": "npm run build",
    "dev:client": "vite dev",
    "dev:server": "tsc -p tsconfig.server.json --watch --preserveWatchOutput",
    "dev:run": "SKIP_OPEN_BROWSER=1 node --watch dist/server/index.js",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ka-Q/studeh.git"
  },
  "bugs": {
    "url": "https://github.com/Ka-Q/studeh/issues"
  },
  "homepage": "https://github.com/Ka-Q/studeh#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
