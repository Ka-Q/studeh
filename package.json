{
  "name": "studeh",
  "version": "0.1.0",
  "private": true,
  "description": "Local image-occlusion study app.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/syncShared.ts && tsc -p tsconfig.server.json && tsc --noEmit -p tsconfig.scripts.json && node scripts/copyStatic.ts && tsc -p tsconfig.client.json && tsc -p tsconfig.client.classic.json",
    "start": "npm run build && node dist/server/index.js",
    "dev": "concurrently -n client,client-classic,static,shared,server,run -c blue,cyan,magenta,gray,green,yellow \"npm:dev:client\" \"npm:dev:client-classic\" \"npm:dev:static\" \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:run\"",
    "predev": "npm run build",
    "dev:client": "tsc -p tsconfig.client.json --watch --preserveWatchOutput",
    "dev:client-classic": "tsc -p tsconfig.client.classic.json --watch --preserveWatchOutput",
    "dev:static": "node --watch-path=src/client/index.html --watch-path=src/client/css --watch-path=src/client/icons scripts/copyStatic.ts",
    "dev:shared": "node --watch-path=src/shared scripts/syncShared.ts",
    "dev:server": "tsc -p tsconfig.server.json --watch --preserveWatchOutput",
    "dev:run": "SKIP_OPEN_BROWSER=1 node --watch dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ka-Q/studeh.git"
  },
  "bugs": {
    "url": "https://github.com/Ka-Q/studeh/issues"
  },
  "homepage": "https://github.com/Ka-Q/studeh#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2"
  }
}
