{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "dom"],
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["tests/**/*.ts", "src/**/*.test.ts", "vite.config.ts", "playwright.config.ts"]
}
